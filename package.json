{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.5.2",
  "description": "DeepSeek Harness desktop shell - Electron wrapper for the official Web UI",
  "main": "main.js",
  "author": "local",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/check-dist-lock.mjs",
    "dist": "electron-builder --win --config builder.yml --publish never",
    "verify:runtime": "node scripts/check-dsh-runtime.mjs",
    "fix:vision-router-portal": "node scripts/patch-vision-router-portal.mjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
